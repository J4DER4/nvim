
snippet log
  console.log(${1:message});

snippet div
  <div>${1:content}</div>

snippet p
  <p>${1:content}</p>

snippet li
  <li>${1:content}</li>

snippet ul
  <ul>
    ${1:/* items */}
  </ul>

snippet a
  <a href="${1:url}">${2:text}</a>

snippet span
  <span>${1:content}</span>

snippet img
  <img src="${1:url}" alt="${2:alt}">

snippet h1
  <h1>${1:title}</h1>

snippet h2
  <h2>${1:title}</h2>
